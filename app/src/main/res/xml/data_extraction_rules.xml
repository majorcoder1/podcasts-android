<?xml version="1.0" encoding="utf-8"?>
<!--
  Subscriptions and playback positions travel; downloaded audio does not. An
  <include> list is exhaustive, so files/episodes/ is left out by omission.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="podcasts.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="podcasts.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
